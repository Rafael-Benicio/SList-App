<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/modal_card"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    tools:ignore="TextSizeCheck">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Big Text and Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Big Text -->
            <TextView
                android:id="@+id/big_text_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/order"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Close Button -->
            <ImageButton
                android:id="@+id/close_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/close_list_modal"
                android:src="@drawable/ic_close" />

        </LinearLayout>

        <!-- Small Text -->
        <TextView
            android:id="@+id/small_text_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/order_the_items_by"
            android:textSize="14sp" />

        <!-- New UI Elements Start Here -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Name Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Label -->
                <TextView
                    android:id="@+id/label_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/name"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <!-- Up Arrow Button -->
                    <ImageButton
                        android:id="@+id/btn_name_up"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/btn_okay"
                        android:contentDescription="@string/name_up"
                        android:src="@drawable/ic_arrow_upward" />

                    <!-- Down Arrow Button -->
                    <ImageButton
                        android:id="@+id/btn_name_down"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/btn_okay"
                        android:contentDescription="@string/name_down"
                        android:src="@drawable/ic_arrow_downward" />

                </LinearLayout>
            </LinearLayout>

            <!-- Value Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Label -->
                <TextView
                    android:id="@+id/label_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/value"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <!-- Up Arrow Button -->
                    <ImageButton
                        android:id="@+id/btn_value_up"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/btn_okay"
                        android:contentDescription="@string/value_up"
                        android:src="@drawable/ic_arrow_upward" />

                    <!-- Down Arrow Button -->
                    <ImageButton
                        android:id="@+id/btn_value_down"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/btn_okay"
                        android:contentDescription="@string/value_down"
                        android:src="@drawable/ic_arrow_downward" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
        <!-- New UI Elements End Here -->

        <!-- Second Big Text -->
        <TextView
            android:id="@+id/big_text_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/delete_mode"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Second Small Text -->
        <TextView
            android:id="@+id/small_text_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/you_will_be_able_to_delete_items"
            android:textSize="14sp" />

        <!-- Delete Button -->
        <Button
            android:id="@+id/delete_btn"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_negate"
            android:text="@string/delete"
            android:textColor="@color/negate_d" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
